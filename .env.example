# Mi Cafetal — Variables de entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA commitees .env

# Supabase (gratis en https://supabase.com)
# Proyecto: mi-cafetal
SUPABASE_URL=https://ioyqlzhzlvkkebvenqnz.supabase.co
# Usa la "Publishable key" (formato sb_publishable_...) — es la clave pública para apps/web
SUPABASE_ANON_KEY=sb_publishable_XXXXXXXX_XXXXXXXXXXXXXX

# Deploy (GitHub Pages o Netlify)
# GitHub Pages usa usuario.github.io/repo — no requiere variable
# Netlify permite dominio personalizado gratis (mi-cafetal.netlify.app)